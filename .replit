modules = ["nodejs-20", "web"]

[nix]
channel = "stable-25_05"
packages = ["mysql84", "nano"]

[agent]
expertMode = true

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5005
externalPort = 80
[deployment]
run = ["bash", "start-production.sh"]
deploymentTarget = "cloudrun"
